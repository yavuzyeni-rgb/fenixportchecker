<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FenixPortChecker"
      Manufacturer="FenixShell"
      Version="0.1.1.0"
      UpgradeCode="a8e3c1f0-4b2d-4e9a-9c17-7f2d1b8e03f2"
      Language="1033"
      Scope="perMachine">
    <SummaryInformation Description="Switch port VLAN, IP ve trafik gozlem araci" />
    <MajorUpgrade DowngradeErrorMessage="Daha yeni bir FenixPortChecker surumu zaten yuklu." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="packaging/portgozu.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FenixPortChecker" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="FenixPortChecker" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="b9f4d2e1-5c3e-4f0b-8d28-8e3e2c9f14a7">
        <File Id="AppExe" Source="dist/FenixPortChecker.exe" />
        <Shortcut
            Id="StartMenuShortcut"
            Directory="AppMenuFolder"
            Name="FenixPortChecker"
            Description="Switch port VLAN / IP / trafik"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon"
            IconIndex="0" />
        <Shortcut
            Id="DesktopShortcut"
            Directory="DesktopFolder"
            Name="FenixPortChecker"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon"
            IconIndex="0" />
        <RemoveFolder Id="RemoveAppMenu" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\FenixShell\FenixPortChecker"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="FenixPortChecker" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
