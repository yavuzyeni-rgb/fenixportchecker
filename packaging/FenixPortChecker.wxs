<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="FenixPortChecker"
      Manufacturer="FenixPortChecker"
      Version="0.1.1.0"
      UpgradeCode="a8e3c1f0-4b2d-4e9a-9c17-7f2d1b8e03f2"
      Language="1033"
      Scope="perMachine">
    <SummaryInformation Description="Switch port VLAN, IP ve trafik gozlem araci" />
    <MajorUpgrade DowngradeErrorMessage="Daha yeni bir FenixPortChecker surumu zaten yuklu." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="packaging/portgozu.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/yavuzyeni-rgb/fenixportchecker" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/yavuzyeni-rgb/fenixportchecker" />

    <!-- Finish dialog: launch app after install (checked by default) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="FenixPortChecker'i calistir" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <CustomAction
        Id="LaunchApplication"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixShellExec"
        Impersonate="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="packaging/License.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="LaunchApplication"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FenixPortChecker" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="FenixPortChecker" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="b9f4d2e1-5c3e-4f0b-8d28-8e3e2c9f14a7">
        <File Id="AppExe" Source="dist/FenixPortChecker.exe" />
        <Shortcut
            Id="StartMenuShortcut"
            Directory="AppMenuFolder"
            Name="FenixPortChecker"
            Description="Switch port VLAN / IP / trafik"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon"
            IconIndex="0" />
        <RemoveFolder Id="RemoveAppMenu" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\FenixPortChecker"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="DesktopShortcutComponent" Guid="c0a5e3f2-6d4f-401c-9e39-9f4f3d0a25b8" Directory="DesktopFolder">
      <Shortcut
          Id="DesktopShortcut"
          Name="FenixPortChecker"
          Description="Switch port VLAN / IP / trafik"
          Target="[INSTALLFOLDER]FenixPortChecker.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon"
          IconIndex="0" />
      <RegistryValue
          Root="HKCU"
          Key="Software\FenixPortChecker"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="FenixPortChecker" Description="Uygulama dosyalari ve Baslat menu kisayolu" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <Feature
          Id="DesktopShortcutFeature"
          Title="Masaustu kisayolu"
          Description="Kurulumdan sonra masaustune FenixPortChecker kisayolu ekle"
          Level="1"
          AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>
  </Package>
</Wix>
